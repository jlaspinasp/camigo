RewriteEngine On

# 1. Send old /something.php URLs to the clean version (index.php is left alone)
RewriteCond %{THE_REQUEST} \s/+(?!index\.php)([^\s?]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Serve /something from something.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/.]+)$ $1.php [L]